#!/usr/bin/env python3
"""
Insomnia - keeps the computer awake while its window is open.

Unlike tray-based tools, this app lives in the taskbar with its own window,
so you can't forget it's running. Closing the window releases the lock.

Two inhibition mechanisms are used together for robustness:
  - Gtk.Application.inhibit(): session manager (cinnamon-session), honored by
    the screensaver and the power manager
  - systemd-inhibit: logind lock, honored by systemd itself
"""

import os
import signal
import subprocess
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

APP_ID = "org.ozh.Insomnia"
APP_NAME = "Insomnia"
REASON = "Insomnia: sleep blocked by the user"

ICON_ACTIVE = "weather-clear"
ICON_INACTIVE = "weather-clear-night"

# Window colors: background / text, for each state
COLOR_ON_BG = "#ffb300"
COLOR_ON_FG = "#1a1a1a"
COLOR_OFF_BG = "#e8eef3"
COLOR_OFF_FG = "#4a5560"

CSS = f"""
window.insomnia-on {{
    background-image: none;
    background-color: {COLOR_ON_BG};
}}
window.insomnia-on label {{
    color: {COLOR_ON_FG};
}}
window.insomnia-off {{
    background-image: none;
    background-color: {COLOR_OFF_BG};
}}
window.insomnia-off label {{
    color: {COLOR_OFF_FG};
}}
"""

# (label, minutes) - 0 means no limit
DURATIONS = [
    ("Indefinitely", 0),
    ("30 minutes", 30),
    ("1 hour", 60),
    ("2 hours", 120),
    ("4 hours", 240),
    ("8 hours", 480),
]


def format_duration(seconds: float) -> str:
    """
    Format a number of seconds as a short human readable string.

    @param seconds: duration in seconds
    @return: formatted string, e.g. "1h05m" or "4m12s"
    """
    h, rem = divmod(int(seconds), 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h{m:02d}m"
    return f"{m}m{s:02d}s"


def load_css() -> None:
    """
    Register the app stylesheet for the whole screen.

    @return: None
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )


class Inhibitor:
    """
    Acquire and release sleep / idle inhibition locks.
    """

    def __init__(self, app: Gtk.Application) -> None:
        """
        @param app: the running Gtk.Application
        @return: None
        """
        self.app = app
        self.cookie = 0
        self.proc = None

    def start(self, window: Gtk.Window, keep_screen_on: bool) -> bool:
        """
        Acquire the locks. Any previous lock is released first.

        @param window: window the inhibition is attached to
        @param keep_screen_on: also prevent screen blanking / screensaver
        @return: True if at least one mechanism succeeded
        """
        self.stop()

        flags = Gtk.ApplicationInhibitFlags.SUSPEND
        what = "sleep"
        if keep_screen_on:
            flags |= Gtk.ApplicationInhibitFlags.IDLE
            what = "sleep:idle"

        self.cookie = self.app.inhibit(window, flags, REASON)

        # "tail --pid" exits by itself if this app dies (even with kill -9),
        # so the logind lock can never outlive us.
        try:
            self.proc = subprocess.Popen(
                [
                    "systemd-inhibit",
                    f"--what={what}",
                    f"--who={APP_NAME}",
                    f"--why={REASON}",
                    "--mode=block",
                    "tail", f"--pid={os.getpid()}", "-f", "/dev/null",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except FileNotFoundError:
            self.proc = None

        return self.cookie != 0 or self.proc is not None

    def stop(self) -> None:
        """
        Release all locks held.

        @return: None
        """
        if self.cookie:
            self.app.uninhibit(self.cookie)
            self.cookie = 0

        if self.proc is not None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
                self.proc.wait(timeout=2)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            self.proc = None


class MainWindow(Gtk.ApplicationWindow):
    """
    Main window: status, duration picker and on/off button.
    """

    def __init__(self, app: Gtk.Application) -> None:
        """
        @param app: the running Gtk.Application
        @return: None
        """
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(360, -1)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.inhibitor = Inhibitor(app)
        self.active = False
        self.started_at = 0.0
        self.ends_at = 0.0
        self.timer_id = 0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(20)
        self.add(box)

        self.status_label = Gtk.Label()
        box.pack_start(self.status_label, False, False, 0)

        self.detail_label = Gtk.Label()
        self.detail_label.get_style_context().add_class("dim-label")
        box.pack_start(self.detail_label, False, False, 0)

        duration_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        duration_row.pack_start(Gtk.Label(label="Duration:"), False, False, 0)
        self.duration_combo = Gtk.ComboBoxText()
        for label, minutes in DURATIONS:
            self.duration_combo.append(str(minutes), label)
        self.duration_combo.set_active(0)
        self.duration_combo.connect("changed", self.on_duration_changed)
        duration_row.pack_start(self.duration_combo, True, True, 0)
        box.pack_start(duration_row, False, False, 0)

        self.screen_check = Gtk.CheckButton(label="Also keep the screen on")
        self.screen_check.set_active(True)
        self.screen_check.connect("toggled", self.on_screen_toggled)
        box.pack_start(self.screen_check, False, False, 0)

        self.toggle_button = Gtk.Button()
        self.toggle_button.set_size_request(-1, 48)
        self.toggle_button.connect("clicked", self.on_toggle_clicked)
        box.pack_start(self.toggle_button, False, False, 0)

        hint = Gtk.Label(label="Closing this window allows sleep again.")
        hint.get_style_context().add_class("dim-label")
        box.pack_start(hint, False, False, 0)

    def selected_minutes(self) -> int:
        """
        @return: selected duration in minutes, 0 for unlimited
        """
        return int(self.duration_combo.get_active_id() or 0)

    def compute_end(self) -> None:
        """
        Set the expiry time from now, according to the selected duration.

        @return: None
        """
        minutes = self.selected_minutes()
        self.ends_at = time.monotonic() + minutes * 60 if minutes else 0.0

    def turn_on(self) -> None:
        """
        Acquire the inhibition and start the countdown.

        @return: None
        """
        ok = self.inhibitor.start(self, self.screen_check.get_active())
        self.active = ok
        if ok:
            self.started_at = time.monotonic()
            self.compute_end()
            if not self.timer_id:
                self.timer_id = GLib.timeout_add_seconds(1, self.on_tick)
        self.refresh_ui(error=not ok)

    def turn_off(self) -> None:
        """
        Release the inhibition and stop the countdown.

        @return: None
        """
        self.inhibitor.stop()
        self.active = False
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = 0
        self.refresh_ui()

    def refresh_ui(self, error: bool = False) -> None:
        """
        Update labels, button, window title and icon from the current state.

        @param error: True if acquiring the lock just failed
        @return: None
        """
        button_ctx = self.toggle_button.get_style_context()
        button_ctx.remove_class("suggested-action")
        button_ctx.remove_class("destructive-action")

        window_ctx = self.get_style_context()
        window_ctx.remove_class("insomnia-on")
        window_ctx.remove_class("insomnia-off")
        window_ctx.add_class("insomnia-on" if self.active else "insomnia-off")

        if error:
            self.status_label.set_markup("<big><b>Failed to block sleep</b></big>")
            self.detail_label.set_text("Could not acquire the sleep lock.")
        elif self.active:
            self.status_label.set_markup("<big><b>☕ Sleep blocked</b></big>")
        else:
            self.status_label.set_markup("<big><b>💤 Sleep allowed</b></big>")
            self.detail_label.set_text("The computer will go to sleep normally.")

        if self.active:
            now = time.monotonic()
            elapsed = format_duration(now - self.started_at)
            if self.ends_at:
                remaining = format_duration(max(0, self.ends_at - now))
                self.detail_label.set_text(f"Running for {elapsed} - {remaining} left")
                self.set_title(f"☕ {APP_NAME} - {remaining}")
            else:
                self.detail_label.set_text(f"Running for {elapsed} - no limit")
                self.set_title(f"☕ {APP_NAME} - active")
            self.toggle_button.set_label("Allow sleep")
            button_ctx.add_class("destructive-action")
            self.set_icon_name(ICON_ACTIVE)
        else:
            self.set_title(f"{APP_NAME} - inactive")
            self.toggle_button.set_label("Block sleep")
            button_ctx.add_class("suggested-action")
            self.set_icon_name(ICON_INACTIVE)

    def on_tick(self) -> bool:
        """
        Called every second while active.

        @return: True to keep the timer running, False to stop it
        """
        if self.ends_at and time.monotonic() >= self.ends_at:
            self.timer_id = 0
            self.turn_off()
            return False
        self.refresh_ui()
        return True

    def on_toggle_clicked(self, _button: Gtk.Button) -> None:
        """
        @param _button: the clicked button
        @return: None
        """
        if self.active:
            self.turn_off()
        else:
            self.turn_on()

    def on_duration_changed(self, _combo: Gtk.ComboBoxText) -> None:
        """
        Restart the countdown from now with the new duration.

        @param _combo: the duration combo box
        @return: None
        """
        if self.active:
            self.compute_end()
            self.refresh_ui()

    def on_screen_toggled(self, _check: Gtk.CheckButton) -> None:
        """
        Re-acquire the lock with the new flags, keeping the countdown.

        @param _check: the checkbox
        @return: None
        """
        if self.active:
            ok = self.inhibitor.start(self, self.screen_check.get_active())
            if not ok:
                self.turn_off()
                self.refresh_ui(error=True)


class InsomniaApp(Gtk.Application):
    """
    Single instance application: launching it again raises the window.
    """

    def __init__(self) -> None:
        """
        @return: None
        """
        super().__init__(application_id=APP_ID)
        self.window = None

    def do_activate(self) -> None:
        """
        @return: None
        """
        if self.window is None:
            load_css()
            self.window = MainWindow(self)
            self.window.show_all()
            self.window.turn_on()
        self.window.present()

    def do_shutdown(self) -> None:
        """
        Make sure every lock is released on exit.

        @return: None
        """
        if self.window is not None:
            self.window.inhibitor.stop()
        Gtk.Application.do_shutdown(self)


def main() -> int:
    """
    @return: process exit code
    """
    app = InsomniaApp()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, app.quit)
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())

